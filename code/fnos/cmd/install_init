#!/bin/bash
# install_init：安装应用文件之前执行 —— 只读预检，不创建、不修改任何东西。
#
# 2026-10-23 0.1.3 安装阻断修复（根因见 M4-0.1.3-安装失败修复报告.md）：
# fnOS 在 install_init 阶段**还没有创建**数据目录 `/vol{n}/@appdata/{app}`，
# 该目录由系统在「解压安装文件」阶段创建（run-as=package 时属主给包用户）。
# 因此：
#   - 本脚本绝不 mkdir / chown / chmod / rm；
#   - 数据目录不存在 = 正常状态，记 info 后 exit 0；
#   - 数据目录存在但当前用户不可写 = 只警告，仍 exit 0（属主问题由系统在
#     文件阶段处理；真正的创建失败由 install_callback 报告，那时系统已就绪）；
#   - 只有 TRIM_PKGVAR 为空，或 VAR_DIR / APPDEST 命中路径黑名单（/、/var 等）
#     才 fail；
#   - TRIM_APPDEST 为空、cmd/main 尚未解压出来都**不是**失败（前者仅诊断用，
#     某些 fnOS 版本在「安装文件前」阶段不注入；后者此阶段可能还没解压）；
#   - 诊断（uid、TRIM_*、父目录 ls -ld、mount/df）只在异常时打印，且不含
#     密码、密钥或任何业务数据。
set -u
umask 027

APP_NAME="FnCal"
VAR_DIR="${TRIM_PKGVAR:-}"
APPDEST="${TRIM_APPDEST:-}"
ETC_DIR="${TRIM_PKGETC:-${VAR_DIR}/etc}"
HOME_DIR="${TRIM_PKGHOME:-${VAR_DIR}/home}"

log_info() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "$1" >>"${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
  fi
  printf '%s\n' "$1" >&2
}

fail() {
  log_info "安装前预检失败：$1"
  exit 1
}

# 只在异常时调用：打印排障所需的最小环境信息（不含密码/密钥/业务数据）。
diag_path() {
  local p="$1"
  [ -n "$p" ] || return 0
  log_info "path: $p"
  log_info "$(ls -ld "$p" 2>&1 || true)"
  log_info "$(findmnt -no FSTYPE,OPTIONS --target "$p" 2>/dev/null || mount 2>/dev/null | grep -m1 " $p " || echo 'mount: 未找到')"
  log_info "$(df -h "$p" 2>/dev/null | tail -n 1 || echo 'df: 不可用')"
}

diag() {
  log_info "---- 诊断信息（install_init）----"
  log_info "uid=$(id -u 2>/dev/null || echo '?') user=$(id -un 2>/dev/null || echo '?') groups=$(id -Gn 2>/dev/null || echo '?')"
  log_info "TRIM_APPNAME=${TRIM_APPNAME:-<未设置>} TRIM_APPVER=${TRIM_APPVER:-<未设置>}"
  log_info "TRIM_PKGVAR=${VAR_DIR:-<未设置>}"
  log_info "TRIM_APPDEST=${APPDEST:-<未设置>}"
  if [ -z "$APPDEST" ]; then
    log_info "TRIM_APPDEST 未注入（install_init 不依赖该变量，仅诊断用）。"
  fi
  log_info "TRIM_PKGETC=${TRIM_PKGETC:-<未设置>} TRIM_PKGHOME=${TRIM_PKGHOME:-<未设置>}"
  diag_path "$(dirname "$VAR_DIR" 2>/dev/null || echo '')"
  if [ -n "$APPDEST" ]; then
    diag_path "$(dirname "$APPDEST" 2>/dev/null || echo '')"
  fi
  log_info "---------------------------------"
}

# ---- 环境检查（只读） ----
# 唯一必需的输入：TRIM_PKGVAR。install_init 不需要 APPDEST，也不要求 app 文件
# 已解压；这两者缺失都不能让安装前预检失败（0.1.3 复核收紧）。
[ -n "$VAR_DIR" ] || fail "缺少 TRIM_PKGVAR 环境变量（应用中心未注入数据目录）。"

case "$VAR_DIR" in
  '/'|'/var'|'/home'|'/root'|'/usr'|'/etc'|'/vol1'|'/vol2'|'/vol3')
    diag
    fail "TRIM_PKGVAR 路径异常（${VAR_DIR}），拒绝继续；请把日志完整回传。"
    ;;
esac

# APPDEST 空 = 仅影响诊断与黑名单校验，不是失败。
if [ -z "$APPDEST" ]; then
  log_info "提示：TRIM_APPDEST 未注入（install_init 不依赖该变量，仅用于诊断）；继续只读预检。"
  diag
else
  case "$APPDEST" in
    '/'|'/var'|'/home'|'/root'|'/usr'|'/etc')
      diag
      fail "TRIM_APPDEST 路径异常（${APPDEST}），拒绝继续；请把日志完整回传。"
      ;;
  esac
fi

# 生命周期脚本可读性：只警告。此阶段 app 文件可能尚未解压，缺失未必是坏包。
CMD_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd || echo '')"
if [ -z "$CMD_DIR" ] || [ ! -f "${CMD_DIR}/main" ]; then
  log_info "警告：生命周期脚本目录不完整（找不到 ${CMD_DIR:-<未知>}/main）；若解压后仍缺失，安装会在后续阶段失败，请把本日志完整回传。"
elif [ ! -x "${CMD_DIR}/main" ]; then
  log_info "提示：${CMD_DIR}/main 缺少执行位（应用中心通常仍可调用；Linux 正式包应为 0755）。"
fi

log_info "${APP_NAME} 安装前预检：VAR=${VAR_DIR} APPDEST=${APPDEST:-<未注入>}"

# ---- 数据目录尚未创建：这是 fnOS 的正常时序，不是错误 ----
if [ ! -d "$VAR_DIR" ]; then
  log_info "数据目录尚未创建，由应用中心在安装文件阶段准备（VAR=${VAR_DIR}）。"
  PARENT="$(dirname "$VAR_DIR")"
  # 父路径存在但不是目录 = 环境明显异常，只做诊断，不阻断安装前预检。
  if [ -e "$PARENT" ] && [ ! -d "$PARENT" ]; then
    log_info "警告：数据目录的上级路径不是目录（${PARENT}），安装文件阶段可能失败；诊断如下。"
    diag
  fi
  log_info "${APP_NAME} 安装前预检完成（未创建/未修改任何目录，退出 0）。"
  exit 0
fi

# ---- 数据目录已存在（重装/升级场景）：只读检查 ----
if [ ! -w "$VAR_DIR" ]; then
  log_info "警告：数据目录当前不可写（${VAR_DIR}）。安装前预检继续；真正的目录准备由 install_callback 在系统建好属主后执行并报告错误。"
  diag
else
  log_info "数据目录已存在且可写：${VAR_DIR}。"
fi
log_info "提示：ETC=${ETC_DIR} HOME=${HOME_DIR}（本脚本不创建，交由 install_callback）。"

log_info "${APP_NAME} 安装前预检完成（未创建/未修改任何目录，退出 0）。"
exit 0
