[
  {
    "stepTitle": "日志",
    "items": [
      {
        "type": "tips",
        "helpText": "日志写入应用数据目录的 logs/ 下，按大小轮转，不记录密码与令牌。调试完成后建议改回 info，避免日志增长过快。"
      },
      {
        "type": "radio",
        "field": "wizard_log_level",
        "label": "日志级别",
        "default": "info",
        "options": [
          { "label": "常规（info，推荐）", "value": "info" },
          { "label": "警告（warn）", "value": "warn" },
          { "label": "仅错误（error）", "value": "error" },
          { "label": "调试（debug）", "value": "debug" }
        ]
      }
    ]
  },
  {
    "stepTitle": "服务端口",
    "items": [
      {
        "type": "tips",
        "helpText": "当前端口来自安装时填写的服务端口；这里改端口会让应用重启，已配置的 CalDAV 客户端需改用新端口。桌面图标的端口不会自动更新：如需卡片按新端口打开，请卸载时保留数据、重装并在安装向导里填新端口。该字段不能为空；未修改时沿用当前值。"
      },
      {
        "type": "text",
        "field": "wizard_port",
        "label": "HTTP 服务端口",
        "placeholder": "如 5280",
        "default": "5280",
        "rules": [
          { "required": true, "message": "请填写服务端口" },
          {
            "pattern": "^(1(0(2[4-9]|[3-9][0-9])|[1-9][0-9]{2})|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "端口必须是 1024–65535 之间的数字（例如 5290）"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_https_port",
        "label": "HTTPS 服务端口",
        "placeholder": "如 5243",
        "default": "5243",
        "helpText": "开启 HTTPS 后监听该端口；必须是 1024–65535 的数字，且不能与 HTTP 端口相同。留空或未修改时沿用当前值。",
        "rules": [
          {
            "pattern": "^$|^(1(0(2[4-9]|[3-9][0-9])|[1-9][0-9]{2})|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
            "message": "端口必须是 1024–65535 之间的数字（例如 5243）"
          }
        ]
      }
    ]
  }
]
