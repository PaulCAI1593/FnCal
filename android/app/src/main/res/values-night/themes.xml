<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 0.2.1（§S2-2b）：深色下状态栏 / 导航栏透明不变，图标改成浅色。 -->
    <style name="Theme.FnCal" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_grad_start</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_grad_start</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
