<?xml version="1.0" encoding="utf-8"?>
<!--
  0.2.2 地址页：照网页「审批页」真源（code/app/api/approval-page.mjs）的配色与排版节奏。
  —— 背景：22% 白光高光 + 135° #1d73d6→#1094b7→#02b497；深色另一套（values-night）。
  —— 一层玻璃浮层（86% 白 / 16dp 圆角 / 55% 白 1dp 描边），API 31+ RenderEffect 真模糊；
     API 24–30 由 ShellChrome 换成 96% 不透明底（真源 @supports 回退）。
  —— 排版（0.2.2 追加）：页头居中，标题 20sp/600、副标题 13sp/text-2，间距 6dp；
     页头到首卡 18dp；卡片 9dp / 内距 14-12 / 间距 10；分组小标题 12sp/600/text-3，距首卡 8dp；
     输入框 48dp / 14dp 内距 / 6dp 圆角；主按钮全宽 48dp；左右留白 20dp，底部 24dp。
  功能字段与 0.2.0 相同：输入框、错误行、自签开关、连接按钮、仍然打开、进度条。
  根容器不加 fitsSystemWindows、不写死 paddingTop；系统栏内距由 ShellChrome 用 insets 补到 shell_body。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ScrollView
        android:id="@+id/shell_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/glass_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingTop="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="20dp">

                <!-- 页头：居中 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- 0.3.0（0.2.3 并入）：标题上方的 72dp logo；同源图标，22% 圆角。
                         纯装饰——标题已说明这是什么，读屏再念一遍只是噪声，故不参与无障碍。 -->
                    <ImageView
                        android:id="@+id/logo_mark"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_marginBottom="16dp"
                        android:contentDescription="@string/logo_content_description"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_mark" />

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/title_address"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textFontWeight="600"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/address_subtitle"
                        android:textColor="@color/text_2"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 服务器地址卡 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/label_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/address_label"
                        android:textColor="@color/text_2"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/input_address"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/address_hint"
                        android:imeOptions="actionGo"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textColorHint="@color/text_3"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/text_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/error_red"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/text_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="2"
                        android:text="@string/address_help"
                        android:textColor="@color/text_3"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 分组：连接设置 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/group_connection"
                    android:textColor="@color/text_3"
                    android:textSize="12sp"
                    android:textFontWeight="600"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp">

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_self_signed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:text="@string/allow_self_signed"
                        android:textColor="@color/text"
                        android:textSize="13sp"
                        app:thumbTint="@color/accent"
                        app:trackTint="@color/border" />

                    <TextView
                        android:id="@+id/text_self_signed_help"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="2"
                        android:text="@string/self_signed_help"
                        android:textColor="@color/text_3"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_connect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_primary"
                    android:minHeight="48dp"
                    android:stateListAnimator="@null"
                    android:text="@string/connect"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_contrast"
                    android:textSize="15sp"
                    android:textFontWeight="600"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progress_connect"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/text_status"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/accent_text"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_open_anyway"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="end|center_vertical"
                    android:minHeight="48dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:stateListAnimator="@null"
                    android:text="@string/open_anyway"
                    android:textAllCaps="false"
                    android:textColor="@color/text_2"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
