<?xml version="1.0" encoding="utf-8"?>
<!--
  0.2.2 关于页：与地址页同一套「审批页」真源（code/app/api/approval-page.mjs）。
  —— 背景：白光高光 + 135° 蓝绿渐变；一层 16dp 玻璃浮层（86% 白 / 55% 描边）；
     API 31+ RenderEffect 真模糊，API 24–30 换 96% 不透明底。
  —— 排版（0.2.2 追加）：标题 20sp/600 左对齐、副标题 13sp 单行；分组小标题 12sp/600/text-3，
     距首卡 8dp、组间 18dp；卡片 9dp / 内距 14-12 / 间距 10；主按钮全宽 48dp；
     左右留白 20dp、底部 24dp；地址单行、中间省略、点开看完整值。
  功能字段与 0.2.0 相同：应用版本、服务器版本、连接状态、当前地址、修改地址、清除缓存、
  检查更新、签名说明、许可。根容器不加 fitsSystemWindows、不写死 paddingTop。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <ScrollView
        android:id="@+id/shell_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/glass_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:paddingLeft="20dp"
                android:paddingTop="20dp"
                android:paddingRight="20dp"
                android:paddingBottom="20dp">

                <!-- 页头：左对齐，副标题单行 -->
                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_about"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textFontWeight="600"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/about_subtitle"
                    android:textColor="@color/text_2"
                    android:textSize="13sp" />

                <!-- 分组：服务（首个分组：10dp + 标题下 8dp = 页头到首卡 18dp） -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/group_service"
                    android:textColor="@color/text_3"
                    android:textSize="12sp"
                    android:textFontWeight="600"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_app_version"
                            android:textColor="@color/text_2"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/text_app_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:textFontWeight="600"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_server_version"
                            android:textColor="@color/text_2"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/text_server_version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:textFontWeight="600"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/border" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/about_connection_status"
                            android:textColor="@color/text_2"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/text_connection_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text"
                            android:textSize="13sp"
                            android:textFontWeight="600"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/border" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/about_address"
                        android:textColor="@color/text_2"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:ellipsize="middle"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/text_2"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 分组：更新 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/group_update"
                    android:textColor="@color/text_3"
                    android:textSize="12sp"
                    android:textFontWeight="600"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/label_update_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/update_source_label"
                        android:textColor="@color/text_2"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/group_update_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/radio_source_cn"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:buttonTint="@color/accent"
                            android:text="@string/update_source_cn"
                            android:textColor="@color/text"
                            android:textSize="13sp" />

                        <RadioButton
                            android:id="@+id/radio_source_direct"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:buttonTint="@color/accent"
                            android:text="@string/update_source_direct"
                            android:textColor="@color/text"
                            android:textSize="13sp" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/text_update_note"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="2"
                        android:text="@string/update_note"
                        android:textColor="@color/text_3"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btn_check_update"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_btn_primary"
                        android:minHeight="48dp"
                        android:stateListAnimator="@null"
                        android:text="@string/check_update"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_contrast"
                        android:textSize="15sp"
                        android:textFontWeight="600"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progress_update"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:layout_marginTop="10dp"
                        android:indeterminate="false"
                        android:indeterminateTint="@color/accent"
                        android:max="100"
                        android:progressTint="@color/accent"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/text_update_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="2"
                        android:textColor="@color/text_2"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_cancel_update"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:minHeight="44dp"
                        android:stateListAnimator="@null"
                        android:text="@string/update_cancel"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="2"
                        android:text="@string/update_signature_note"
                        android:textColor="@color/text_3"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 分组：桌面卡片 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/group_desktop"
                    android:textColor="@color/text_3"
                    android:textSize="12sp"
                    android:textFontWeight="600"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="4"
                        android:text="@string/about_desktop_hint"
                        android:textColor="@color/text_2"
                        android:textSize="13sp" />

                    <!-- 0.6.2 §F：卡片跟随 App 登录态，不再需要令牌。 -->
                    <TextView
                        android:id="@+id/widget_login_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/about_widget_status_signed_out"
                        android:textColor="@color/text_2"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_widget_refresh"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_btn_primary"
                        android:minHeight="48dp"
                        android:stateListAnimator="@null"
                        android:text="@string/about_widget_refresh"
                        android:textAllCaps="false"
                        android:textColor="@color/accent_contrast"
                        android:textSize="14sp" />                </LinearLayout>

                <!-- 分组：关于 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/group_about"
                    android:textColor="@color/text_3"
                    android:textSize="12sp"
                    android:textFontWeight="600"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingLeft="14dp"
                    android:paddingTop="12dp"
                    android:paddingRight="14dp"
                    android:paddingBottom="12dp">

                    <Button
                        android:id="@+id/btn_change_address"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:minHeight="44dp"
                        android:stateListAnimator="@null"
                        android:text="@string/about_change_address"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_clear_data"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:minHeight="44dp"
                        android:stateListAnimator="@null"
                        android:text="@string/about_clear_data"
                        android:textAllCaps="false"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="2"
                    android:text="@string/about_license"
                    android:textColor="@color/text_3"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
