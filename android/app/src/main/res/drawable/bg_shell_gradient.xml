<?xml version="1.0" encoding="utf-8"?>
<!-- 0.2.1（§S2）：两页共用的背景渐变。浅色 #EAF1F8 → #E3F0EA，深色由
     values-night/colors.xml 覆盖；angle=270 即从上到下。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/bg_grad_end"
        android:startColor="@color/bg_grad_start"
        android:type="linear" />
</shape>
