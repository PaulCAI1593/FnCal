<?xml version="1.0" encoding="utf-8"?>
<!--
  0.2.0 地址页 / 关于页背景：CSS 135°（左上→右下）三色渐变。

  Android 的 gradient angle 以「0 = 左→右、逆时针为正」计，45 = 左下→右上，
  所以 CSS 135° 的等价写法是 315（左上→右下）。这里用 315，颜色顺序与范围文档
  令牌一致：#0B2637 → #12495C → #0E6B62。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/bg_grad_mid"
        android:endColor="@color/bg_grad_end"
        android:startColor="@color/bg_grad_start"
        android:type="linear" />
</shape>
