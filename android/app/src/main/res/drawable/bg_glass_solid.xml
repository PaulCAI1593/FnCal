<?xml version="1.0" encoding="utf-8"?>
<!-- 0.2.2：API 24–30 没有 backdrop-filter，按真源 :220-225 的回退口径
     把玻璃层提高到 96% 不透明度，保证文字对比；圆角与描边不变。
     ShellChrome.installBackdrop 在低版本把玻璃容器的背景换成这一张。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_fill_solid" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
