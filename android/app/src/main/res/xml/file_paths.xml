<?xml version="1.0" encoding="utf-8"?>
<!--
  0.2.0 更新安装包的共享路径：DownloadManager 把 APK 写到
  getExternalFilesDir(DIRECTORY_DOWNLOADS)/FnCal/updates/，这里按同一相对路径
  暴露给包安装器（ACTION_VIEW 需要 content:// + FLAG_GRANT_READ_URI_PERMISSION）。
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path
        name="updates"
        path="Download/FnCal/updates/" />
</paths>
